# =============================================================================
# Proxify — Host Mode Configuration (port 9090)
# =============================================================================
# Copy to .env to activate:  cp .env.host .env
#
# This configuration is for running proxify directly on the host,
# NOT inside Docker. All service URLs point to localhost.
# =============================================================================

# ── Server Ports ──────────────────────────────────────────────────
API_PORT=9090
PROXY_PORT=8889
API_HOST=0.0.0.0

# ── Redis (running on host) ──────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ── FlareSolverr (NOT running on host — disable) ─────────────────
FLARESOLVERR_ENABLED=false
FLARESOLVERR_URL=http://localhost:8191/v1

# ── Scrapling ─────────────────────────────────────────────────────
SCRAPLING_ENABLED=true
SCRAPLING_HEADLESS=true
SCRAPLING_SOLVE_CLOUDFLARE=true
SCRAPLING_BLOCK_WEBRTC=true
SCRAPLING_HIDE_CANVAS=true

# ── curl_cffi TLS impersonation ──────────────────────────────────
CURL_CFFI_ENABLED=true
CURL_CFFI_IMPERSONATE=chrome131,chrome124,safari18_0,safari17_0,chrome146,chrome142,chrome136,edge101,firefox133

# ── Lib++ (next-gen strategies) ──────────────────────────────────
CURL_CFFI_PLUS_ENABLED=true
NODRIVER_ENABLED=true
TLS_ROTATOR_ENABLED=true
NODRIVER_POOL_SIZE=3

# ── Cache ─────────────────────────────────────────────────────────
CACHE_ENABLED=true
L1_CACHE_MAX_SIZE=10000
L1_CACHE_TTL=300
L2_CACHE_TTL=3600

# ── Strategy Order (11-tier pipeline) ────────────────────────────
STRATEGY_ORDER=curl_cffi_plus,simple,drissionpage_plus,nodriver,tls_rotator,scrapling,flaresolverr,playwright,puppeteer,puppeteer_plus,gui_chrome

# ── Session Management ────────────────────────────────────────────
SESSION_TTL=1800
SESSION_CLEANUP_INTERVAL=300

# ── Rate Limiting ─────────────────────────────────────────────────
GLOBAL_RATE_LIMIT=100
PER_DOMAIN_RATE_LIMIT=10

# ── Circuit Breaker ───────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN=60

# ── GUI Chrome (persistent headful browser in Xvfb :99) ──────────
GUI_CHROME_ENABLED=true
COOKIE_FILE=/home/irfan/Backup/searchapi/proxify/proxy-orchestrator/gui-cookies.txt
COOKIE_REFRESH_INTERVAL=1800

# ── Stealth Persona (pinned to one identity) ─────────────────────
PERSONA_PINNED=true
PERSONA_TLS=chrome146
PERSONA_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36
PERSONA_ACCEPT_LANGUAGE=en-US,en;q=0.9
PERSONA_SEC_CH_UA="Not_A Brand";v="24", "Chromium";v="146", "Google Chrome";v="146"
PERSONA_PLATFORM="Windows"
PERSONA_VIEWPORT=1920

# ── Browser Engines ───────────────────────────────────────────────
PLAYWRIGHT_ENABLED=true
PUPPETEER_ENABLED=true
PUPPETEER_PLUS_ENABLED=true
DRISSIONPAGE_PLUS_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Request Dedup ─────────────────────────────────────────────────
DEDUP_WINDOW=5.0

# ── HTTP Methods ──────────────────────────────────────────────────
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,HEAD,OPTIONS
