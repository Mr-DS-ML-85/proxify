# =============================================================================
# Lib++ Configuration Template
# =============================================================================

# === Stealth Browser (nodriver via HTTP bridge — NO MCP) ===
STEALTH_BROWSER_URL=http://stealth-browser:8000

# === Proxify (existing 6-tier pipeline) ===
PROXY_ORCHESTRATOR_URL=http://proxy-orchestrator:8080

# === Strategy Order (7-tiers with Lib++ enhanced) ===
# curl_cffi_plus → tls_rotator → simple → scrapling → nodriver → flaresolverr → puppeteer_plus
STRATEGY_ORDER=curl_cffi_plus,tls_rotator,simple,scrapling,nodriver,flaresolverr,puppeteer_plus

# === TLS Profile Management ===
# Comma-separated impersonation targets for TLS rotation
CURL_CFFI_IMPERSONATE=chrome131,chrome130,chrome129,chrome128,chrome127,chrome126,chrome125,chrome124

# === Anti-Fingerprinting ===
# Enable canvas/WebGL/WebRTC spoofing in all strategies
ENABLE_CANVAS_SPOOF=true
ENABLE_WEBGL_SPOOF=true
ENABLE_WEBRTC_BLOCK=true

# === HTTP/3 + WebSocket ===
ENABLE_HTTP3=false  # Requires aioquic
ENABLE_WEBSOCKET=false  # Requires websockets

# === Nodriver Pool ===
NODRIVER_POOL_SIZE=3
NODRIVER_IDLE_TIMEOUT=300

# === Puppeteer+ (Inline Script, No Tempfile) ===
PUPPETEER_PLUS_ENABLED=true

# === Logging ===
LOG_LEVEL=INFO

# === Proxy ===
# UPSTREAM_PROXIES=http://proxy1:8080,http://proxy2:8080
# PROXY_ROTATION_STRATEGY=round_robin  # round_robin, random, sticky

# === Cache ===
CACHE_ENABLED=true
L1_CACHE_TTL=300
L2_CACHE_TTL=3600

# === Domain Tracker (TLS per-domain learning) ===
DOMAIN_TRACKER_ENABLED=true
